<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Vérification des prix suivis en arrière-plan (voir Notifier.refreshTaskID). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lemwincher.app.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<!-- Minuteurs du mode cuisine dans la Dynamic Island et sur l'écran verrouillé. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Écran de lancement : le citron sur fond vert (vert très sombre en mode sombre). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
